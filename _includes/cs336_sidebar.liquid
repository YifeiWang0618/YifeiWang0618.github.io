{% assign series = include.series | default: site.data.cs336 %}
{% assign current_path = page.url | remove: 'index.html' %}
{% unless current_path contains series.base_path %}
  {% assign current_path = series.home_path %}
{% endunless %}

<nav class="cs336-series-nav" aria-label="{{ series.title }} series">
  <div class="cs336-series-brand">
    <a href="{{ series.home_path | relative_url }}" class="cs336-series-title">{{ series.title }}</a>
    {% if series.description %}
      <p class="cs336-series-desc">{{ series.description }}</p>
    {% endif %}
  </div>

  {% for section in series.sections %}
    <div class="cs336-series-section">
      <p class="cs336-series-heading">{{ section.title }}</p>
      <ul>
        {% for item in section.items %}
          {% assign item_path = item.path | append: '/' | replace: '//', '/' %}
          {% assign is_active = false %}
          {% if current_path == item.path or current_path == item_path %}
            {% assign is_active = true %}
          {% endif %}
          <li
            {% if is_active %}
              class="is-active"
            {% endif %}
          >
            <a
              href="{{ item.path | relative_url }}"
              {% if is_active %}
                aria-current="page"
              {% endif %}
            >
              {{- item.title -}}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endfor %}
</nav>
